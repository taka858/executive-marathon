---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = '北米在住テックリーダーが、ランニング・トライアスロンの実体験から、日本のビジネスパーソンに海外で戦う体と心のつくり方を伝えるサイト。', ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://executive-marathon.com');
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title} | Executive Marathon</title>
    <meta name="description" content={description} />

    <!-- OGP -->
    <meta property="og:site_name" content="Executive Marathon" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage || 'https://executive-marathon.com/og-default.png'} />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- GA4 -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-2ES90HSWL0');
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2ES90HSWL0"></script>
  </head>
  <body class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100">
    <header class="sticky top-0 z-50 bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
      <nav class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-bold text-blue-600 dark:text-blue-400">Executive Marathon</a>
        <ul class="flex gap-6 text-sm font-medium">
          <li><a href="/career/" class="hover:text-blue-600">北米キャリア</a></li>
          <li><a href="/mindset/" class="hover:text-blue-600">マインドセット</a></li>
          <li><a href="/running/" class="hover:text-blue-600">ランニング</a></li>
          <li><a href="/triathlon/" class="hover:text-blue-600">トライアスロン</a></li>
          <li><a href="/about/" class="hover:text-blue-600">About</a></li>
        </ul>
      </nav>
    </header>

    <main class="min-h-screen">
      <slot />
    </main>

    <footer class="bg-slate-100 dark:bg-slate-800 border-t border-slate-200 dark:border-slate-700">
      <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">
          <div>
            <h3 class="font-bold mb-2">北米キャリア</h3>
            <ul class="text-sm space-y-1">
              <li><a href="/career/" class="hover:text-blue-600">キャリアガイド</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold mb-2">マインドセット</h3>
            <ul class="text-sm space-y-1">
              <li><a href="/mindset/" class="hover:text-blue-600">思考法</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold mb-2">ランニング</h3>
            <ul class="text-sm space-y-1">
              <li><a href="/running/" class="hover:text-blue-600">ギアガイド</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold mb-2">その他</h3>
            <ul class="text-sm space-y-1">
              <li><a href="/privacy/" class="hover:text-blue-600">プライバシーポリシー</a></li>
              <li><a href="/contact/" class="hover:text-blue-600">お問い合わせ</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-slate-300 dark:border-slate-600 pt-4 text-center text-sm text-slate-600 dark:text-slate-400">
          <p>&copy; 2026 Executive Marathon. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
