---
interface Item {
  name: string;
  [key: string]: string | number | boolean;
}

interface Props {
  title: string;
  items: Item[];
  columns: string[];
}

const { title, items, columns } = Astro.props;
---

<div class="my-6">
  <h3 class="text-lg font-bold mb-4">{title}</h3>
  <div class="overflow-x-auto">
    <table class="w-full border-collapse border border-slate-300 dark:border-slate-600">
      <thead>
        <tr class="bg-slate-100 dark:bg-slate-700">
          <th class="border border-slate-300 dark:border-slate-600 px-4 py-2 text-left font-bold">
            商品
          </th>
          {columns.map((col) => (
            <th class="border border-slate-300 dark:border-slate-600 px-4 py-2 text-left font-bold text-sm">
              {col}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {items.map((item) => (
          <tr>
            <td class="border border-slate-300 dark:border-slate-600 px-4 py-2 font-medium">
              {item.name}
            </td>
            {columns.map((col) => (
              <td class="border border-slate-300 dark:border-slate-600 px-4 py-2 text-sm">
                {item[col]}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
