---
interface Props {
  title: string;
  image?: string;
  description?: string;
  amazonUrl?: string;
  rakutenUrl?: string;
  yahooUrl?: string;
}

const { title, image, description, amazonUrl, rakutenUrl, yahooUrl } = Astro.props;
---

<div class="border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden mb-6 bg-slate-50 dark:bg-slate-800">
  {image && (
    <img
      src={image}
      alt={title}
      class="w-full h-48 object-cover"
    />
  )}
  <div class="p-4">
    <h3 class="font-bold text-lg mb-2">{title}</h3>
    {description && (
      <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        {description}
      </p>
    )}
    <div class="flex gap-2 flex-wrap">
      {amazonUrl && (
        <a
          href={amazonUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white text-sm font-medium rounded transition"
        >
          Amazon
        </a>
      )}
      {rakutenUrl && (
        <a
          href={rakutenUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white text-sm font-medium rounded transition"
        >
          楽天
        </a>
      )}
      {yahooUrl && (
        <a
          href={yahooUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded transition"
        >
          Yahoo
        </a>
      )}
    </div>
  </div>
</div>
