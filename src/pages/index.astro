---
import Base from '../layouts/Base.astro';
---

<Base title="Executive Marathon | 北米テックリーダーが伝える、海外で戦う体と心のつくり方">
  <section class="bg-gradient-to-b from-blue-50 dark:from-slate-800 to-white dark:to-slate-900 py-16">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold mb-6 text-slate-900 dark:text-white">
        海外で戦う体と心のつくり方
      </h1>
      <p class="text-xl text-slate-600 dark:text-slate-300 mb-8">
        北米在住・現役テックリーダーが、ランニング・トライアスロンの実体験から、日本のビジネスパーソンと海外を目指す若者へ。
      </p>
      <div class="flex gap-4 justify-center">
        <a href="/career/" class="px-6 py-3 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700">
          北米キャリア記事へ
        </a>
        <a href="/running/" class="px-6 py-3 bg-slate-200 dark:bg-slate-700 text-slate-900 dark:text-white rounded-lg font-medium hover:bg-slate-300 dark:hover:bg-slate-600">
          ランニング記事へ
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold mb-12 text-center">3つの柱</h2>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-slate-50 dark:bg-slate-800 p-8 rounded-lg">
        <h3 class="text-xl font-bold mb-4">北米キャリア</h3>
        <p class="text-slate-600 dark:text-slate-400">
          海外志向の大学生・20-30代向け。英語学習、転職、留学に関するハウツーとマインドセット。
        </p>
        <a href="/career/" class="text-blue-600 dark:text-blue-400 font-medium mt-4 inline-block hover:underline">
          記事を読む →
        </a>
      </div>

      <div class="bg-slate-50 dark:bg-slate-800 p-8 rounded-lg">
        <h3 class="text-xl font-bold mb-4">マインドセット</h3>
        <p class="text-slate-600 dark:text-slate-400">
          30-50代ビジネスパーソン向け。判断疲れ、習慣化、リーダーシップなど、仕事と人生を整える思考法。
        </p>
        <a href="/mindset/" class="text-blue-600 dark:text-blue-400 font-medium mt-4 inline-block hover:underline">
          記事を読む →
        </a>
      </div>

      <div class="bg-slate-50 dark:bg-slate-800 p-8 rounded-lg">
        <h3 class="text-xl font-bold mb-4">ランニング・トライアスロン</h3>
        <p class="text-slate-600 dark:text-slate-400">
          初心者から中級ランナー向け。ギア選び、トレーニング方法、レース参戦記。
        </p>
        <a href="/running/" class="text-blue-600 dark:text-blue-400 font-medium mt-4 inline-block hover:underline">
          記事を読む →
        </a>
      </div>
    </div>
  </section>
</Base>
